#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/pointing.h>

// Layers
#define BASE     0
#define MOUSE    1
#define NAV      2
#define GRAPHITE 3

/ {
    behaviors {
        hrm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;

            flavor = "tap-preferred";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;

            bindings = <&kp>, <&kp>;

            /* hold-trigger-on-release; */
        };


        hrms: homerow_mods_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_SHIFT";
            #binding-cells = <2>;

            flavor = "balanced";
            require-prior-idle-ms = <125>;
            tapping-term-ms = <150>;
            quick-tap-ms = <125>;

            bindings = <&kp>, <&kp>;

            /* hold-trigger-on-release; */
        };

        /* Overwriting existing &mt */
        mt: mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            label = "MOD_TAP";

            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;

            bindings = <&kp>, <&kp>;

            hold-trigger-on-release;
        };

        /* Overwriting existing &lt */
        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            label = "LAYER_TAP";
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
            display-name = "Layer-Tap";
        };

        /* Graphite mod-morphs: shift pairs that differ from QWERTY
         *
         * Graphite  unshifted → shifted   (QWERTY shifted)
         *   '       '         → _         (")
         *   ,       ,         → ?         (<)
         *   -       -         → "         (_)
         *   /       /         → <         (?)
         */

        gr_sqt: graphite_sqt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SQT>, <&kp UNDERSCORE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        gr_comma: graphite_comma {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp QMARK>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        gr_minus: graphite_minus {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp DQT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        gr_fslh: graphite_fslh {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp FSLH>, <&kp LT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "base";
            bindings = <
&kp F1     &kp F2       &kp F3       &kp F4         &kp F5        &kp F6    &kp F7   &kp F8        &kp F9         &kp F10      &kp F11         &kp F12
&kp GRAVE  &kp N1       &kp N2       &kp N3         &kp N4        &kp N5    &kp N6   &kp N7        &kp N8         &kp N9       &kp N0          &kp EQUAL
&kp TAB    &kp Q        &kp W        &kp E          &kp R         &kp T     &kp Y    &kp U         &kp I          &kp O        &kp P           &kp MINUS
&kp ESC    &hrm LGUI A  &hrm LALT S  &hrms LSHFT D  &hrm LCTRL F  &kp G     &kp H    &hrm LCTRL J  &hrms RSHFT K  &hrm RALT L  &hrm RGUI SEMI  &kp SQT
&kp LGUI   &kp Z        &kp X        &kp C          &kp V         &kp B     &kp N    &kp M         &kp COMMA      &kp DOT      &kp FSLH        &kp BSLH
                        &kp UP       &kp DOWN                                                      &kp LEFT       &kp RIGHT
                            &kp LBKT   &lt MOUSE RET  &kp DEL                  &mt RCTRL BSPC  &lt NAV SPACE  &kp RBKT
                            &kp PG_UP  &mo MOUSE      &kp PSCRN                &kp INS         &tog GRAPHITE  &kp PG_DN
            >;
        };

        layer_1 {
            display-name = "mouse";
            bindings = <
&bt BT_CLR       &bt BT_SEL 0     &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &trans      &trans          &trans          &trans        &trans           &trans    &trans
&rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &trans        &trans        &trans        &trans      &kp F7          &kp F8          &kp F9        &kp F10          &kp F11   &kp F12
&trans           &trans           &trans        &trans        &kp DEL       &trans      &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &kp LBKT  &kp RBKT
&tog NAV         &kp LC(A)        &kp LALT      &kp LSHFT     &kp LCTRL     &trans      &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &kp LBRC  &kp RBRC
&trans           &kp LC(Z)        &kp LC(X)     &kp LC(C)     &kp LC(V)     &kp LC(B)   &trans          &trans          &trans        &trans           &trans    &kp RGUI
                                  &trans        &trans                                                                  &trans        &trans
                                                &trans  &trans  &trans                      &mkp LCLK  &mkp RCLK  &trans
                                                &trans  &trans  &trans                      &trans     &trans     &trans
            >;
        };

        layer_2 {
            display-name = "nav";
            bindings = <
&rgb_ug RGB_TOG  &trans        &trans    &trans    &trans     &trans      &trans  &trans     &trans     &trans    &trans    &trans
&kp F1           &kp F2        &kp F3    &kp F4    &kp F5     &kp F6      &trans  &trans     &trans     &trans    &trans    &trans
&trans           &trans        &kp HOME  &kp UP    &kp END    &kp INS     &trans  &trans     &trans     &trans    &trans    &trans
&tog MOUSE       &kp C_VOL_UP  &kp LEFT  &kp DOWN  &kp RIGHT  &kp PG_UP   &trans  &kp LCTRL  &kp RSHFT  &kp RALT  &kp RGUI  &trans
&kp LGUI         &kp C_VOL_DN  &trans    &trans    &trans     &kp PG_DN   &trans  &trans     &trans     &trans    &trans    &trans
                               &trans    &trans                                   &trans     &trans
                           &trans  &kp RET  &trans                             &trans  &trans  &trans
                           &trans  &trans   &trans                             &trans  &trans  &trans
            >;
        };

        layer_3 {
            display-name = "graphite";
            bindings = <
&kp F1     &kp F2         &kp F3        &kp F4         &kp F5        &kp F6    &kp F7   &kp F8        &kp F9         &kp F10      &kp F11      &kp F12
&kp GRAVE  &kp N1         &kp N2        &kp N3         &kp N4        &kp N5    &kp N6   &kp N7        &kp N8         &kp N9       &kp N0       &kp EQUAL
&kp TAB    &kp B          &kp L         &kp D          &kp W         &kp Z     &gr_sqt  &kp F         &kp O          &kp U        &kp J        &kp SEMI
&kp ESC    &hrm LGUI N    &hrm LALT R   &hrms LSHFT T  &hrm LCTRL S  &kp G     &kp Y    &hrm LCTRL H  &hrms RSHFT A  &hrm RALT E  &hrm RGUI I  &gr_comma
&kp LGUI   &kp Q          &kp X         &kp M          &kp C         &kp V     &kp K    &kp P         &kp DOT        &gr_minus    &gr_fslh     &kp BSLH
                          &kp UP        &kp DOWN                                                      &kp LEFT       &kp RIGHT
                              &kp LBKT   &lt MOUSE RET  &kp DEL                      &mt RCTRL BSPC  &lt NAV SPACE  &kp RBKT
                              &kp PG_UP  &none          &kp PSCRN                    &kp INS         &tog GRAPHITE  &kp PG_DN
            >;
        };
    };
};
